        <mxCell id="n1" value="Начало" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Временной ряд наблюдений&#10;и флаги качества" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="260" y="130" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Для каждой метрики обобщить&#10;качество источника по всей истории" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="260" y="230" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="История метрики&#10;имеет пропуски?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="260" y="330" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Определить направление (↑ / ↓)&#10;по корреляции значений со временем" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="470" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Направление считается&#10;неопределённым" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Подать последнее значение&#10;в активное направление (↑ или ↓)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="560" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Подать последнее значение&#10;в оба направления (↑ и ↓)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Для каждого симптома базы знаний&#10;оценить состояние входного терма&#10;(см. таблицу состояний)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
