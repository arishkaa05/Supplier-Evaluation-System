        </mxCell>
        <mxCell id="n10" value="Для каждого правила базы знаний&#10;применить операцию «и» (метаконъюнкцию)&#10;к состояниям трёх входных термов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
